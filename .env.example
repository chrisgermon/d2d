# Documents to DICOM Configuration
HOST=0.0.0.0
PORT=8000
ARCHIVE_PATH=./dicom_archive
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=50000000

# Optional deployment info shown in UI footer
# Example: 2026-01-25 15:43:40 AEST
DEPLOYMENT_TIMESTAMP=

# API Security Settings
# Set to true to require API key authentication (default: true)
REQUIRE_API_KEY=true
# Comma-separated list of valid API keys
API_KEYS=your-secure-api-key-here
